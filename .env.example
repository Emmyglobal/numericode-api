# Server
PORT=3001
NODE_ENV=development

# Database — PostgreSQL
# For local development: postgresql://postgres:password@localhost:5432/numerycode
# For Supabase production: postgresql://postgres:password@db.xxxxx.supabase.co:6543/postgres
# Get Supabase connection string from: Project Settings → Database → Connection Pooling
DATABASE_URL=postgresql://postgres:password@localhost:5432/numerycode

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS & email links)
CLIENT_URL=http://localhost:5173

# ── Email (SendGrid) ──────────────────────────────────────────────────────────
# IMPORTANT: The EMAIL_FROM address MUST be verified in your SendGrid account.
# Unverified senders cause SPF/DKIM failures → emails go to spam or are rejected.
# Verify at: https://app.sendgrid.com/settings/sender_auth/senders
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@numerycode.com
EMAIL_FROM_NAME=NumeryCode
CONTACT_EMAIL_TO=nwaforugochukwu21@gmail.com

# ── Google OAuth ───────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# The GOOGLE_REDIRECT_URI must match the URL registered in Google Cloud Console.
# In production: https://your-api-domain.com/api/auth/google/callback
# In development: http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# ── AI (OpenAI) ────────────────────────────────────────────────────────────────
# Used by the AI Study Guide, lesson content generator, quiz generator, and
# assignment generator. Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# ── Payments (Paystack) ────────────────────────────────────────────────────────
# SECRET key — SERVER ONLY. Never expose to the frontend, never commit real keys.
# Test keys start with sk_test_; live keys with sk_live_.
# Create/find keys at: https://dashboard.paystack.com/#/settings/developers
# Also configure the webhook URL in the Paystack dashboard (live + test):
#   https://<your-api-domain>/api/payments/webhook/paystack
PAYSTACK_SECRET_KEY=

# ── Supabase Storage (persistent file uploads) ────────────────────────────────
# Create a PUBLIC bucket named "resources" in Supabase Storage, then uncomment:
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_STORAGE_BUCKET=resources
# Without these, uploads fall back to the local `uploads/` folder, which works
# but is wiped on every redeploy (ephemeral disk on Render).
