# Server
PORT=3001
NODE_ENV=development

# Database — PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/numericode

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS & email links)
CLIENT_URL=http://localhost:5173

# ── Email (SendGrid) ──────────────────────────────────────────────────────────
# IMPORTANT: The EMAIL_FROM address MUST be verified in your SendGrid account.
# Unverified senders cause SPF/DKIM failures → emails go to spam or are rejected.
# Verify at: https://app.sendgrid.com/settings/sender_auth/senders
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@numericode.com
EMAIL_FROM_NAME=NumeriCode
CONTACT_EMAIL_TO=nwaforugochukwu21@gmail.com

# ── Google OAuth ───────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# The GOOGLE_REDIRECT_URI must match the URL registered in Google Cloud Console.
# In production: https://your-api-domain.com/api/auth/google/callback
# In development: http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# ── AI (OpenAI) ────────────────────────────────────────────────────────────────
# Used by the AI Study Guide, lesson content generator, quiz generator, and
# assignment generator. Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
