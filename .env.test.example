# ─── Test environment (copy to .env.test — NEVER commit the real file) ────────
#
# The backend integration suite creates, updates and deletes rows, so it only
# runs against a DISPOSABLE test database: it refuses to start unless
# DATABASE_URL_TEST names a database whose name ends with "_test".
#
# One-time setup
#   1. Create the test database (separate from any development or production DB):
#        createdb numerycode_test
#      or, with psql:
#        psql -U postgres -c "CREATE DATABASE numerycode_test;"
#   2. Copy this file to .env.test and fill in DATABASE_URL_TEST (see below).
#   3. Create the schema inside the test database, then optionally load fixtures:
#        DATABASE_URL="$DATABASE_URL_TEST" npm run db:migrate
#        DATABASE_URL="$DATABASE_URL_TEST" npm run db:seed
#   4. Run the suite:
#        npm test
#
# Safety rules enforced by src/test/dbGuard.ts (see README → Testing):
#   • Tests NEVER fall back to DATABASE_URL. If DATABASE_URL_TEST is missing,
#     blank or unusable, the suite stops before opening any connection.
#   • The database name must end with "_test" (e.g. numerycode_test), so the
#     production database (…/postgres) can never be selected by accident.
#   • The host that serves this project's production database is refused, as are
#     Render/Railway/Supabase hosts unless ALLOW_REMOTE_TEST_DB=1 is set for a
#     separate test project.
#   • Never put production credentials in this file, and never point
#     DATABASE_URL_TEST at the production database.
#
# .env.test is gitignored — keep it that way.

DATABASE_URL_TEST=postgresql://postgres:your-local-password@localhost:5432/numerycode_test

# Only required when the test database is NOT on localhost (for example a
# separate Supabase/Neon project used exclusively for tests). The database name
# must still end with "_test". Leave unset for a local test database.
# ALLOW_REMOTE_TEST_DB=1
